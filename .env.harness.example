# Harness 研发验收（不与 .env 叠加）
#   cp .env.harness.example .env.harness
#   node scripts/harness/load-env.mjs --check
# 对客沙箱：docs/harness-credentials.md · docs/harness-tutorial.md

# =============================================================================
# ① 必填
# =============================================================================

CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=

# =============================================================================
# ② 可选 — magent 默认 agent
# =============================================================================

# CLOUDBASE_AGENT_ID=agent-my-sandbox-agent-xxxxxx

# =============================================================================
# ③ 可选 — cloud-scf BYOK（仅 npm run harness -- cloud-scf）
# =============================================================================

# LLM_API_KEY=
# LLM_MODEL=
# OPENAI_BASE_URL=
# engine=claude 时再填 ANTHROPIC_BASE_URL（与 LLM_API_KEY 共用，勿用 ANTHROPIC_AUTH_TOKEN）

# =============================================================================
# ④ 可选 — 沙箱镜像 / 首次创 AGS 工具
# =============================================================================

# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/<角色名>
# HARNESS_TOOL_ID=sdt-xxxxxxxx
# HARNESS_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/<ns>/<image>:<tag>

# =============================================================================
# ⑤ 可选 — 云上 agent pin（研发；交付验收勿填）
# =============================================================================

# HARNESS_CLOUD_AGENT_ID=agent-oma-harness-xxxxxxxx
# HARNESS_CLOUD_SCF_AGENT_ID=agent-oma-harness-scf-xxxxxxxx

# =============================================================================
# ⑥ 可选 — COS（HARNESS_COS_ENABLED=1 时下列全部必填）
# =============================================================================

# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
