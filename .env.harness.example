# Harness 研发验收（不与 .env 叠加）
#   cp .env.harness.example .env.harness
#   magent login && tcb env use <envId>
#   node scripts/harness/load-env.mjs --check
#
# 场景矩阵（③ LLM / ⑥ COS）：scripts/harness/scenarios/README.md
# CI / 手填 CloudBase 变量：docs/harness-env.md#advanced-settings

# =============================================================================
# ① CloudBase — 默认留空（magent login + tcb env use 后 load-env / deploy 自动补齐）
# =============================================================================

# CLOUDBASE_ENV_ID=
# TCB_REGION=
# TCB_SECRET_ID=
# TCB_SECRET_KEY=

# =============================================================================
# ② 可选 — magent 默认 agent
# =============================================================================

# CLOUDBASE_AGENT_ID=agent-my-sandbox-agent-xxxxxx

# =============================================================================
# ③ LLM — 不在此文件；按场景见 scripts/harness/scenarios/.env.<scenario>
# =============================================================================
# LLM_API_KEY=
# LLM_MODEL=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# =============================================================================
# ④ 可选 — 沙箱镜像 / 首次创 AGS 工具
# =============================================================================

# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/<角色名>
# HARNESS_TOOL_ID=sdt-xxxxxxxx
# HARNESS_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/<ns>/<image>:<tag>

# =============================================================================
# ⑥ 可选 — COS（HARNESS_COS_ENABLED=1 时下列全部必填）
# =============================================================================

# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
