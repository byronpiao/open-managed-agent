# Harness 验收环境变量（完整模板）
#
# 步骤 0（唯一 env 文件，不与 .env 叠加）：
#   cp .env.harness.example .env.harness
#   node scripts/harness/load-env.mjs --check
#
# 文档：docs/harness-architecture.md · Harness一条龙.md
# 对客沙箱 Agent：docs/harness-tutorial.md（部署用 agent.yaml，不用本文件）

# =============================================================================
# ① 必填 — local / cloud-tcbr / cloud-scf 都要
# =============================================================================

CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=
# 云开发环境 API Key（控制台 → 环境 → API Key，或 tcb sandbox apikey create）
# harness 沙箱 Agent 两处共用这一把（无需再填 LLM_API_KEY）：
#   1. AGS 沙箱数据面（起箱、访问箱内 TRW）
#   2. 默认 CloudBase AI 模型（hy3-preview；箱内 opencode / claude 调 LLM）
TCB_API_KEY=
# magent run / SDK 访问 Agent 网关（可与 TCB_API_KEY 相同，也可单独创建）
CLOUDBASE_ACCESS_KEY=

# =============================================================================
# ② 可选 — magent / SDK 默认 agent
# =============================================================================

# CLOUDBASE_AGENT_ID=

# =============================================================================
# ③ 可选 — 自定义 LLM（仅 cloud-scf 一条龙需要；local 用 ① TCB_API_KEY 平台额度）
# =============================================================================
#
# | 验收命令              | 模型来源                          |
# | test:full / local     | CloudBase AI hy3-preview（① 段）  |
# | harness -- cloud-tcbr | opencode zen（忽略本段）          |
# | harness -- cloud-scf  | 本段 LLM_* + OPENAI_BASE_URL      |
#
# Token Plan 区划 CN/SGP 不通用；验 key：
#   node scripts/harness/load-env.mjs --check --probe-llm
#
# engine=opencode 或 codebuddy（OpenAI Chat Completions）：
# LLM_API_KEY=tp-xxxxxxxx
# LLM_MODEL=mimo-v2.5-pro
# OPENAI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
#
# engine=claude（Anthropic Messages，同一 LLM_API_KEY）：
# LLM_API_KEY=tp-xxxxxxxx
# LLM_MODEL=mimo-v2.5-pro
# ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic

# =============================================================================
# ④ 沙箱镜像 / AGS Tool
# =============================================================================
#
# HARNESS_TOOL_ROLE_ARN — 未 pin HARNESS_TOOL_ID 时 CreateSandboxTool 必填（AGS 沙箱实例角色，≠ SCF 执行角色）。
# 可从已有 tool 的 RoleArn 抄，或控制台 AGS → 沙箱工具详情。
# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/agent-sandbox
#
# HARNESS_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/tcb-sandbox-public-cbe88d/tcb-sandbox-public-cbe88d:tag-magent
# HARNESS_TOOL_ID=sdt-xxxxxxxx   # 仅写在此文件；禁止 shell export 后跑 cloud-scf

# =============================================================================
# ⑤ 可选 — 云上验收 agent pin（研发内部，推荐；走 agent:update 而非每次 create）
# =============================================================================

# HARNESS_CLOUD_AGENT_ID=agent-oma-harness-xxxxxxxx
# HARNESS_CLOUD_SCF_AGENT_ID=agent-oma-harness-scf-xxxxxxxx

# =============================================================================
# ⑥ 可选 — COS 工作区持久化（HARNESS_COS_ENABLED=1 时下列全部必填）
# =============================================================================
#
# 默认（不启用）：多轮对话靠 harness_sync_events 恢复；沙箱磁盘随 AGS TTL 清空。
# 启用 COS：工作区挂 COS，session/delete 时 snapshot → 新沙箱 re-acquire 后现场可续。
# 验收：HARNESS_COS_ENABLED=1 → npm run harness -- local 含 cos-e2e 硬门。
#
# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
