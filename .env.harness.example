# cp .env.harness.example .env.harness（gitignore）
# 叠加在 .env 之上；同名键以本文件为准（见 scripts/load-env.mjs）

# ── LLM（harness / cloudrun-set-env / docs/scf-debugging 复现）────────────
# 默认 deploy 不配 → opencode 内置 zen（免 key）
# 自定义 Mimo 等：取消注释；opencode 用 OPENAI /v1，claude 引擎用 ANTHROPIC_BASE_URL
# LLM_API_KEY=
# LLM_MODEL=mimo-v2.5-pro
# OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
#
# tools/cloudrun-set-env.mjs：读 LLM_API_KEY + ANTHROPIC_BASE_URL（优先于 .env 的 ANTHROPIC_AUTH_TOKEN）

# ── 可选：覆盖内置公开 magent 镜像 ───────────────────────────────────────
# HARNESS_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/tcb-sandbox-public-cbe88d/tcb-sandbox-public-cbe88d:tag-magent
# HARNESS_SANDBOX_IMAGE_REGISTRY_TYPE=personal

# ── 自动创建 harness-{envId} Tool（已有 HARNESS_TOOL_ID 可省略）────────────
# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/agent-sandbox

# ── 固定复用已有 Sandbox Tool（COS 时推荐 pin）────────────────────────────
# HARNESS_TOOL_ID=sdt-xxxxxxxx

# ── 云上 harness：`npm run harness -- cloud` ───────────────────────────────
# HARNESS_CLOUD_AGENT_ID=agent-oma-harness-xxxxxxxx

# ── COS（HARNESS_COS_ENABLED=1 时下列全部必填）──────────────────────────────
# SECRET_MASTER_KEY 由 harness_sessions 按 ACP 会话生成，勿手填。
# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
# HARNESS_COS_SUBPATH=
