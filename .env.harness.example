# Harness 验收环境变量（完整模板）
#
# 步骤 0（唯一 env 文件，不与 .env 叠加）：
#   cp .env.harness.example .env.harness
#   node scripts/harness/load-env.mjs --check
#
# 文档：docs/harness-architecture.md · Harness一条龙.md
# 对客沙箱 Agent：docs/harness-tutorial.md（部署用 agent.yaml，不用本文件）

# =============================================================================
# ① 必填 — local / cloud / cloud-scf 都要
# =============================================================================

CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_API_KEY=
CLOUDBASE_ACCESS_KEY=

# =============================================================================
# ② 可选 — magent / SDK 默认 agent
# =============================================================================

# CLOUDBASE_AGENT_ID=

# =============================================================================
# ③ 可选 — 自定义 LLM（仅 harness -- cloud；local test:full 用 zen，留空即可）
# =============================================================================
#
# Token Plan（tp-*）区划 CN/SGP 不通用；验 key：
#   node scripts/harness/load-env.mjs --check --probe-llm
#
# LLM_API_KEY=tp-xxxxxxxx
# LLM_MODEL=mimo-v2.5-pro
# OPENAI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic

# =============================================================================
# ④ 可选 — 沙箱镜像 / AGS Tool
# =============================================================================

# HARNESS_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/tcb-sandbox-public-cbe88d/tcb-sandbox-public-cbe88d:tag-magent
# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/agent-sandbox
# HARNESS_TOOL_ID=sdt-xxxxxxxx

# =============================================================================
# ⑤ 可选 — 云上验收 agent pin（研发内部，非对客）
# =============================================================================

# HARNESS_CLOUD_AGENT_ID=agent-oma-harness-xxxxxxxx
# HARNESS_CLOUD_SCF_AGENT_ID=agent-oma-harness-scf-xxxxxxxx

# =============================================================================
# ⑥ 可选 — COS 工作区快照（HARNESS_COS_ENABLED=1 时下列全部必填）
# =============================================================================

# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
