# 沙箱 Agent（runtime: harness）— OMA 研发 / npm run harness 验收
#
#   cp .env.harness.example .env.harness
#   cp agent.harness.yaml.example agent.harness.yaml
#   npm run dev:harness
#
# magent 部署：只需 agent.harness.yaml（见 docs/harness-tutorial.md）。
# 验收矩阵：本文件（①④⑤⑥）+ scripts/harness/scenarios/.env.<格子>（③ LLM）

# =============================================================================
# ① CloudBase — 默认留空（magent login + tcb env use 后自动补齐）
# =============================================================================

# CLOUDBASE_ENV_ID=
# TCB_REGION=
# TCB_SECRET_ID=
# TCB_SECRET_KEY=

# =============================================================================
# ② 可选 — 已部署 agent id（验收 pin / ma-protocol）
# =============================================================================

# CLOUDBASE_AGENT_ID=agent-my-sandbox-agent-xxxxxx

# =============================================================================
# ③ LLM — 按场景格子，见 scenarios/.env.<格子>.example
# =============================================================================

# =============================================================================
# ④ AGS 工具（镜像在 agent.harness.yaml sandbox.image / imageRegistryType）
# =============================================================================
#
# | .env.harness 键 | 用途 |
# |-----------------|----------------------|
# | HARNESS_TOOL_ID | 验收 pin 沙箱工具 |
# | HARNESS_TOOL_ROLE_ARN | 首次 CreateSandboxTool |
#
# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/<角色名>
# HARNESS_TOOL_ID=sdt-xxxxxxxx

# =============================================================================
# ⑤ 云上 agent pin（研发加速 update，见 scenarios/README.md）
# =============================================================================

# HARNESS_CLOUD_TCBR_OPENCODE_AGENT_ID=
# HARNESS_CLOUD_SCF_OPENCODE_AGENT_ID=

# =============================================================================
# ⑥ 可选 — COS（研发验收 cos-e2e；loadEnv 默认不注入，见 scenarios/README.md）
# =============================================================================

# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
