# cp .env.harness.example .env.harness（gitignore）
# 与 .env 叠加；默认公开 magent 镜像已内置，多数情况不必改下面「少用」项。

# --- LLM（一套 key/model，两套 base URL 对应 opencode / claude）---
LLM_API_KEY=
LLM_MODEL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# --- 可选：覆盖内置公开 magent 镜像（默认见 harness-env HARNESS_PUBLIC_MAGENT_IMAGE）---
# HARNESS_SANDBOX_IMAGE=ccr.ccs.tencentyun.com/tcb-sandbox-public-cbe88d/tcb-sandbox-public-cbe88d:tag-magent
# HARNESS_SANDBOX_IMAGE_REGISTRY_TYPE=personal

# --- 自动创建 harness-{envId} Tool 时必填（已 HARNESS_TOOL_ID 则可省略）---
# HARNESS_TOOL_ROLE_ARN=qcs::cam::uin/<uin>:roleName/agent-sandbox

# --- 固定复用已有 Sandbox Tool（推荐 COS 时 pin 已有 COS tool）---
# HARNESS_TOOL_ID=sdt-xxxxxxxx

# --- COS（HARNESS_COS_ENABLED=1 时下列全部必填，无内置兜底）---
# SECRET_MASTER_KEY 由 harness_sessions 按 ACP 会话生成，勿手填。
# HARNESS_COS_ENABLED=1
# HARNESS_COS_BUCKET=
# HARNESS_COS_BUCKET_PATH=
# HARNESS_COS_ENDPOINT=
# HARNESS_COS_REGION=
# HARNESS_COS_MOUNT_NAME=
# HARNESS_COS_MOUNT_DIR=/mnt/workspace
# HARNESS_COS_SUBPATH=          # 可选；跨实例复现同一前缀
