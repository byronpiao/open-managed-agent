{
  "name": "open-managed-agent",
  "version": "0.0.1",
  "description": "magent CLI — manage CloudBase AI agents from the command line",
  "bin": {
    "magent": "./magent.mjs"
  },
  "files": [
    "magent.mjs",
    "lib",
    "README.md"
  ],
  "keywords": [
    "magent",
    "cloudbase",
    "agent",
    "cli",
    "ai",
    "open-managed-agent"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/sdk",
    "packages/agent-runtime"
  ],
  "dependencies": {
    "@cloudbase/cli": "latest",
    "@cloudbase/signature-nodejs": "^2.2.0",
    "open-managed-agent-runtime": "workspace:*",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.24.0",
    "undici": "^7.27.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:sdk": "npm run build --workspace=packages/sdk",
    "build:runtime": "npm run build --workspace=packages/agent-runtime",
    "test": "npm run build && node tests/stop-and-resume.test.mjs && node tests/harness/unit.test.mjs && node tests/managed-agents/unit.test.mjs && node tests/managed-agents/e2e-managed-agents-harness.test.mjs",
    "test:full": "npm test && npm run harness -- local",
    "test:delivery": "npm run build:runtime && node scripts/harness/delivery.mjs",
    "harness:smoke": "npm run test:full && npm run harness:cloud-opencode",
    "harness:run": "npm run build:runtime && node scripts/harness/run.mjs",
    "harness": "npm run build:runtime && node scripts/harness/index.mjs",
    "harness:local": "npm run harness -- local --engines opencode",
    "harness:local-claude": "npm run harness -- local --engines claude",
    "harness:local-all": "npm run harness -- local --engines all",
    "harness:product-acceptance": "npm run harness -- product-acceptance",
    "harness:quickstart": "npm run build:runtime && node scripts/harness/quickstart.mjs",
    "harness:cloud": "npm run harness:cloud-opencode",
    "harness:cloud-opencode": "npm run harness -- cloud-opencode",
    "harness:cloud-claude": "npm run harness -- cloud-claude",
    "harness:cloud-tcbr": "npm run harness:cloud-tcbr-opencode",
    "harness:cloud-scf": "npm run harness:cloud-scf-opencode",
    "harness:cloud-tcbr-opencode": "npm run harness -- cloud-tcbr-opencode",
    "harness:cloud-scf-opencode": "npm run harness -- cloud-scf-opencode",
    "harness:cloud-tcbr-claude": "npm run harness -- cloud-tcbr-claude",
    "harness:cloud-scf-claude": "npm run harness -- cloud-scf-claude",
    "ma-protocol": "npm run build && node scripts/harness/managed-agents-protocol.mjs"
  }
}
