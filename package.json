{
  "name": "open-managed-agent",
  "version": "0.0.1",
  "description": "magent CLI — manage CloudBase AI agents from the command line",
  "bin": {
    "magent": "./magent.mjs"
  },
  "files": [
    "magent.mjs",
    "lib",
    "README.md"
  ],
  "keywords": [
    "magent",
    "cloudbase",
    "agent",
    "cli",
    "ai",
    "open-managed-agent"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/sdk",
    "packages/agent-runtime"
  ],
  "dependencies": {
    "@cloudbase/cli": "latest",
    "@cloudbase/signature-nodejs": "^2.2.0",
    "commander": "^15.0.0",
    "open-managed-agent-runtime": "workspace:*",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.24.0",
    "undici": "^7.27.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:sdk": "npm run build --workspace=packages/sdk",
    "build:runtime": "npm run build --workspace=packages/agent-runtime",
    "test": "npm run build && node tests/stop-and-resume.test.mjs && node tests/harness/unit.test.mjs && node tests/managed-agents/unit.test.mjs && node tests/managed-agents/e2e-managed-agents-harness.test.mjs",
    "test:merge": "OAK_USE_MEMORY_STORE=1 npm test && npm run harness -- run --infra local --engine opencode",
    "dev:harness": "node scripts/dev-harness.mjs",
    "harness": "npm run build:runtime && node scripts/harness/index.mjs",
    "check:harness": "node scripts/check-harness-ready.mjs"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
