# Dockerfile.scf — SCF (Tencent Serverless Cloud Function) image-mode runtime.
#
# Why a separate image from the TCBR Dockerfile?
#   - SCF web function image must listen on PORT=9000 (TCBR uses 8080).
#   - SCF /tmp at runtime is owned root:root mode 0755 — uid=1001 cannot
#     write to it via the standard "scf_bootstrap drops to uid=1001" path.
#     So we pre-create the writable subdirs (/tmp/.oak /tmp/workspace)
#     AT BUILD TIME and chown them to 1001; scf_bootstrap also re-creates
#     + chowns them at runtime (build-time chown is reset by the SCF mount).
#     /tmp/.oak is the kernel's unified work root (OAK_SESSION_LOCAL_DIR=/tmp →
#     <workRoot>/.oak/{agent,users,sync}); /tmp/workspace is the session cwd.
#   - We bake the linux-x64 native claude binary into the image so the SDK
#     never has to extract or fetch it at runtime, and the optionalDeps
#     platform-skip dance is gone.
#
# This image is meant to be deployed via `tcb fn deploy --deployMode image`
# (or via the SCF imageConfig field in cloudbaserc.json).

FROM node:20-bullseye-slim

ENV TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
        bash \
        git \
 && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
 && echo $TZ > /etc/timezone \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --shell /bin/bash --uid 1001 agent \
 && mkdir -p /app /tmp/.oak /tmp/workspace \
 && chown -R agent:agent /app /tmp/.oak /tmp/workspace \
 && chmod 0755 /tmp/.oak /tmp/workspace

WORKDIR /app

# Install deps as root, but with --os=linux --cpu=x64 forced so the SDK's
# linux-x64 optional binary actually lands. We do this BEFORE switching to
# the agent user so npm has full write access and any post-install scripts
# can complete cleanly.
COPY package*.json ./
COPY vendor ./vendor

RUN npm install --omit=dev --no-audit --no-fund \
        --os=linux --cpu=x64 --include=optional --force \
 && rm -f node_modules/.package-lock.json \
 && npm install --omit=dev --no-audit --no-fund \
        --os=linux --cpu=x64 --include=optional --force \
 && test -x node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude \
 || (echo "FATAL: claude-agent-sdk-linux-x64/claude binary missing" && exit 1)

# Now copy the rest of the agent code and hand it to the agent user.
COPY . .
RUN chown -R agent:agent /app

# NOTE: intentionally NO `USER agent` here. The container starts as root so
# uid-shim.mjs (loaded via --import in CMD, and in scf_bootstrap) can chown the
# runtime /tmp — SCF mounts it root:root, defeating build-time chown — then drop
# to uid 1001 before the kernel/claude binary loads. `USER agent` would start at
# 1001, the runtime chown would fail, and the claude subprocess couldn't write
# under /tmp → SDK yields 0 messages → empty SSE.

# SCF web function gateway probes this port. Don't change without also
# updating cloudbaserc.json's imageConfig.imagePort.
EXPOSE 9000

# OAK_SESSION_LOCAL_DIR = kernel work root → all kernel-managed dirs live under
#   <workRoot>/.oak/ (agent config, per-user memory, COS sync). Pin to /tmp (SCF's
#   only guaranteed-writable area) so the kernel skips home-writability probing.
# We do NOT set CLAUDE_CONFIG_DIR: the kernel sets it unconditionally to
#   <workRoot>/.oak/agent/.claude — setting it here would be ignored/misleading.
# HOME is irrelevant to the kernel (it writes via CLAUDE_CONFIG_DIR, not $HOME).
ENV PORT=9000 \
    OAK_SESSION_LOCAL_DIR=/tmp

    
CMD ["node", "dist/index.js"]
