{
  "name": "open-managed-agent-runtime",
  "version": "0.1.0",
  "description": "OpenManagedAgent Runtime - deployed as cloud function",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./harness": "./dist/harness/index.js"
  },
  "scripts": {
