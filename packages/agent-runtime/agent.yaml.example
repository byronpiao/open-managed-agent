# OpenManagedAgent Configuration — example / template
#
# Copy this file to agent.yaml to activate it (local managed dev):
#   cp ../../agent.yaml.example agent.yaml
#
# Repo-root template: agent.yaml.example · harness: agent.harness.yaml.example
#
# Schema mirrors Anthropic Managed Agents API:
# https://platform.claude.com/docs/en/managed-agents/agent-setup

name: OpenManagedAgent Coding Assistant
model: hy3-preview
system: You are a helpful coding assistant. You can read, write, and execute code.
description: A coding agent with file system and shell access.

# Where the agent loop runs: local | harness (sandbox ACP) | oak
runtime: managed          # default — 托管运行时（网关 OAK loop）
# runtime: harness        # 沙箱 Agent（Harness 运行时）
# engine: opencode        # 箱内引擎（ACP 服务端），仅 runtime=harness：opencode | claude | codebuddy

# Tools configuration
# Supported types: agent_toolset, custom, mcp_toolset
tools:
  # Built-in agent toolset (bash, read, write, edit, glob, grep)
  - type: agent_toolset
    default_config:
      enabled: true
      permission_policy:
        type: always_allow    # always_allow | always_ask
    configs:
      - name: bash
        enabled: true
        # permission_policy:
        #   type: always_ask  # Uncomment to require confirmation for shell commands

  # Custom tools — ALWAYS client-side execution.
  # YAML can only declare a tool's contract (name + description + input_schema);
  # it has no place to put an implementation. So every `type: custom` tool
  # below is executed by the *client* that opened the session/prompt stream.
  #
  # Wire flow (managed): tool_use_request → App executes → tool_result
  # Wire flow（沙箱 Agent）: managed-agent-client MCP bridge → gateway → App (same semantics)
  # acquire() binds ?sessionId={acpSessionId} on MCP URL + HARNESS_ACP_SESSION_ID env
  # - type: custom
  #   name: query_database
  #   description: Execute a read-only SQL query against the application database.
  #   input_schema:
  #     type: object
  #     properties:
  #       sql:
  #         type: string
  #         description: The SQL SELECT query to execute
  #     required: [sql]

  # MCP toolset (tools from remote MCP server)
  # - type: mcp_toolset
  #   mcp_server_name: github
  #   default_config:
  #     permission_policy:
  #       type: always_allow

# MCP Servers
# Each mcp_toolset above must reference a server declared here.
mcp_servers: []
  # - type: url
  #   name: github
  #   url: https://api.githubcopilot.com/mcp/
  #   # Custom HTTP headers
  #   headers:
  #     Authorization: Bearer <token>

# Skills — installed into deploy bundle as skills/<name>/SKILL.md (+ assets).
# Skills — 完整 8 种 source 写法见仓库根目录：
#   docs/examples/agent.skills-sources.example.yaml
#
# 本地路径须使用 file: 前缀，例如 file:./skills/my-skill
skills: []

# Arbitrary metadata for tracking
metadata:
  runtime: open-managed-agent
  version: "0.1.0"
