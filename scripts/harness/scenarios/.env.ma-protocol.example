# Managed Agents HTTP protocol — pin deployed harness Runtime agent id.
# Deploy template: scripts/harness/scenarios/agent.ma-protocol.yaml
#
# 填入 magent agent:create / npm run harness -- cloud-* 产出的 agent id
#   magent agent:update -f scripts/harness/scenarios/agent.ma-protocol.yaml -i <agent-id>
#
HARNESS_MA_PROTOCOL_AGENT_ID=agent-xxxxxxxx
# CLOUDBASE_AGENT_ID=agent-xxxxxxxx   # legacy alias (optional)
