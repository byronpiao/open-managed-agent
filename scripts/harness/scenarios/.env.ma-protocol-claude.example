# Managed Agents HTTP protocol (claude) — pin deployed harness Runtime agent id.
# Deploy template: scripts/harness/scenarios/agent.ma-protocol-claude.yaml
#
#   magent agent:create ...
#   magent agent:update -f scripts/harness/scenarios/agent.ma-protocol-claude.yaml -i <agent-id>
#
HARNESS_MA_PROTOCOL_AGENT_ID=agent-xxxxxxxx
# CLOUDBASE_AGENT_ID=agent-xxxxxxxx   # legacy alias (optional)
