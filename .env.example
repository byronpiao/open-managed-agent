# 托管 Agent（默认 runtime）/ SDK / integration 测试
#   cp .env.example .env
#
# 沙箱 Agent（runtime=harness）研发验收用另一文件，不要写进 .env：
#   cp .env.harness.example .env.harness
#   见 docs/harness-credentials.md · Harness一条龙.md

# ── CloudBase ───────────────────────────────────────────────────────────────
CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=

# magent run / SDK：有 CAM 或 magent login 时可省略；否则填网关 Bearer
# CLOUDBASE_ACCESS_KEY=

# integration / manual-demo 默认 Agent
CLOUDBASE_AGENT_ID=
