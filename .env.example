# 托管 Agent / SDK / integration 测试用（复制为 .env，勿提交）
#   cp .env.example .env
#
# Harness 研发验收用独立文件（不要写进 .env）：
#   cp .env.harness.example .env.harness
#   node scripts/harness/load-env.mjs --check

# ── CloudBase 控制面 ────────────────────────────────────────────────────────
CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_API_KEY=

# SDK / 网关 Bearer（可与 TCB_API_KEY 相同）
CLOUDBASE_ACCESS_KEY=

# 默认 Agent（integration / manual-demo）
CLOUDBASE_AGENT_ID=
