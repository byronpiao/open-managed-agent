# 托管 Agent（runtime: managed）— OMA 研发 / SDK 集成
#
#   cp .env.example .env
#   cp agent.yaml.example agent.yaml        # magent 用户主配置在 agent.yaml
#
# magent 部署日常只需 agent.yaml + login，不必建本文件。
# 使用指南：README.md

# ── CloudBase ───────────────────────────────────────────────────────────────
CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=

# magent run / SDK：有 magent login 时可省略
# CLOUDBASE_ACCESS_KEY=

CLOUDBASE_AGENT_ID=

# ── 调试覆盖（不要用于产品配置）────────────────────────────────────────
# 日常改 name / model / system 请写 agent.yaml，不要设下面这些变量。
# 仅本地调试或测试需要临时盖 yaml 时才打开：AGENT_ENV_OVERRIDES=1
# AGENT_ENV_OVERRIDES=1
# AGENT_NAME=
# AGENT_MODEL=
# AGENT_SYSTEM=
