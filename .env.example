# Copy to .env and fill in (never commit .env)
#   cp .env.example .env
#
# Harness 一条龙：cp .env.harness.example .env.harness → npm run test:full
#   见 packages/agent-runtime/src/harness/README.md
#   node scripts/load-env.mjs --check

# CloudBase（magent / AGS）
CLOUDBASE_ENV_ID=
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_API_KEY=

# API Key（JWT，SDK/CLI 访问 Agent）
CLOUDBASE_ACCESS_KEY=

# 默认 Agent ID（可选）
CLOUDBASE_AGENT_ID=
