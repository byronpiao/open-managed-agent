# CloudBase Managed Agent - Environment Variables
# Copy this file to .env and fill in your values
# Usage: source .env && cbagent agent:list

# CloudBase 环境 ID
CLOUDBASE_ENV_ID=

# 腾讯云 AK/SK（用于 tcb login）
TCB_SECRET_ID=
TCB_SECRET_KEY=

# API Key（JWT Token，用于 SDK/CLI 访问 Agent）
CLOUDBASE_ACCESS_KEY=

# 默认 Agent ID（可选，设置后 cbagent 命令可省略 --id）
CLOUDBASE_AGENT_ID=
