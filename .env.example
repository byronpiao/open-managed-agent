# Copy to .env and fill in (never commit .env)
#   cp .env.example .env
#
# Harness overlay: cp .env.harness.example .env.harness
#   npm run harness -- local|cloud · npm run test:full
#   node scripts/load-env.mjs --check
#
# load-env order: .env → .env.harness (harness wins on duplicate keys)

# ── CloudBase 控制面（magent / AGS / harness DB）────────────────────────────
CLOUDBASE_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=
TCB_API_KEY=

# SDK / 网关 Bearer（tests/integration.ts、tests/agui-integration.ts、tests/manual-demo.mjs）
# 可与 TCB_API_KEY 相同；二选一即可，代码优先 CLOUDBASE_ACCESS_KEY
CLOUDBASE_ACCESS_KEY=

# 默认 Agent（integration / manual-demo；agui 可用 AGENT_ID 覆盖）
CLOUDBASE_AGENT_ID=

# ── OAK 薄模式 / 本地 runtime（AGENT_CONFIG 注入时可选）────────────────────
# ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# 未设 .env.harness 时，tools/cloudrun-set-env.mjs 也会读这两项
