# OMA Agent Runtime — 镜像同步配置
# 说明：README.md

# ═══════════════════════════════════════════════════════
# 全部可选 — 留空则系统自动创建
# ═══════════════════════════════════════════════════════

TCR_MODE=personal
# TCR_NAMESPACE=open-managed-agent       # 默认 open-managed-agent
# TCR_USERNAME=                           # 自动开通 CCR 账号
# TCR_PASSWORD=                           # 已注册用户填写

# TCR_IMAGE_NAME=oma-agent-runtime        # 镜像在 TCR 中的名字

# 企业版（需要 CAM 授权）：
# TCR_MODE=enterprise
# TCR_INSTANCE_ID=tcr-xxxxxxxx
# TCR_REGION=ap-shanghai
