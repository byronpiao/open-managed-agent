# OMA Agent Runtime — 镜像同步配置
# 说明：USAGE.md
#
# 从未用过 CCR：留空即可，系统自动开通。
# 已用过 CCR（在控制台设置过访问凭证）：必须填写下面两项。

TCR_MODE=personal
# TCR_UIN=100047749993                    # 你的腾讯云 UIN（CCR 登录名）
# TCR_PASSWORD=                            # CCR 访问凭证密码
#
# 其他可选：
# TCR_NAMESPACE=open-managed-agent        # 默认 open-managed-agent
# TCR_IMAGE_NAME=open-managed-agent        # 镜像名字
